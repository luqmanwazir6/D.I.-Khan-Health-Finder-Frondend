# ---------------------------------------------------------------
# D.I. Khan Service Finder — frontend environment variables
# Copy this file to `.env` (or `.env.local`) and adjust values.
# Only variables prefixed with VITE_ are exposed to the browser.
# Never put secrets here — everything below ships to the client.
# ---------------------------------------------------------------

# Base URL of the backend REST API, INCLUDING the version prefix.
# All service modules call paths relative to this (e.g. /providers).
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Request timeout in milliseconds for API calls.
VITE_API_TIMEOUT=15000

# Public application name (used in page titles).
VITE_APP_NAME=D.I. Khan Service Finder

# Default city slug used for searches when the user hasn't picked one.
VITE_DEFAULT_CITY=dera-ismail-khan
